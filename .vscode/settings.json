{
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.fixAll": "always",
    }
  },
  //RUFF
  //"ruff.configuration": "${workspaceFolder}/pyproject.toml",
  "ruff.organizeImports": true,
  "ruff.fixAll": true,

  //autodocstring
  "autoDocstring.docstringFormat": "google",


  //PYLINT
  "pylint.cwd": "${workspaceFolder}",
  "pylint.path": [
    "${interpreter}",
    "-m",
    "pylint"
  ],
  "pylint.args": [
    "--unsafe-load-any-extension",
    "yes",
    "--disable",
    "missing-class-docstring,missing-module-docstring,logging-fstring-interpolation",
    "--init-hook",
    "import sys; sys.path.append('.')"
  ],

  //MYPY
  "mypy-type-checker.args": [
    "--disable-error-code",
    "import-untyped"
  ],

  //BANDIT
  "bandit.args": [
    "-s",
    "B101,B311"
  ],
  "terminal.integrated.env.windows": {
    "PYTHONBREAKPOINT": "ipdb.sset_trace"
  },

  //TESTING
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,

  //Robot Framework
  /*
  
  "robotcode.debug.attachPython": true,
  "robotcode.robot.pythonPath": [
  ".",
  ],
  "robotcode.robocop.enabled": true,
  "robotcode.robocop.ignoreFileConfig": false,
  "robotcode.robot.args": ["-A", "."],
  */
}